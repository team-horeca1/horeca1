# ═══ DEMO / STAGING — demo.horeca1.com ═══
# Copy to /opt/horeca1/.env.demo on the droplet. NEVER point at production DB/Redis.
# NEVER put rzp_live_ Razorpay keys here. Prefer omitting MSG91/RESEND so notifications log only.

APP_ENV=demo
NODE_ENV=production

# Auth — separate secret so demo sessions cannot be reused on production.
AUTH_SECRET=generate-a-different-32-char-secret-from-production
AUTH_URL=https://demo.horeca1.com
AUTH_TRUST_HOST=true

# Overridden by docker-compose.demo.yml — kept here for documentation.
# DATABASE_URL=postgresql://horeca1_demo:...@demo-postgres:5432/horeca1_demo
# REDIS_URL=redis://demo-redis:6379/0

# Payments — TEST keys only (rzp_test_...)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# Leave MSG91 / RESEND unset on demo so SMS/email fall back to console logs.
# MSG91_AUTH_KEY=
# RESEND_API_KEY=

EMAIL_FROM=Horeca1 Demo <noreply@demo.horeca1.com>

# ImageKit / Maps / Sentry — optional; can share public keys with prod for demo media.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_PRIVATE_KEY=
# IMAGEKIT_URL_ENDPOINT=
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

CRON_SECRET=generate-demo-cron-secret
